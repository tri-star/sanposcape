{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
    "ask": [
      "Edit(/.github/workflows/**)"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/knowledge/record-memory-access.sh\"",
            "timeout": 10,
            "suppressOutput": true
          }
        ]
      }
    ],

    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/knowledge/memory-write-guard.sh\"",
            "timeout": 20,
            "statusMessage": "メモリの規約を検査中..."
          }
        ]
      }
    ]
  },

  "sandbox": {
    "network": {
      "allowedDomains": [
        "expo.dev",
        "*.expo.dev",
        "exp.host",
        "*.expo.io",
        "dl.google.com",
        "maven.google.com",
        "repo.maven.apache.org",
        "repo1.maven.org",
        "*.gradle.org",
        "jitpack.io"
      ]
    },

    "excludedCommands": [
      "adb *",
      "bash scripts/mobile-tools/*",
      "scripts/mobile-tools/*",
      "./scripts/mobile-tools/*",
      "*.exe*"
    ]
  }
}
