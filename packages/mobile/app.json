{
  "expo": {
    "name": "sanposcape (Dev)",
    "slug": "sanposcape",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/app-icons/sanposcape-icon-1024.png",
    "scheme": "sanposcape-dev",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.sanposcape.app.dev",
      "icon": "./assets/app-icons/sanposcape-icon-1024.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#208AEF",
        "foregroundImage": "./assets/app-icons/android/adaptive-foreground.png",
        "backgroundImage": "./assets/app-icons/android/adaptive-background.png",
        "monochromeImage": "./assets/app-icons/android/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sanposcape.app.dev",
      "permissions": ["android.permission.POST_NOTIFICATIONS"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "react-native-edge-to-edge",
      [
        "react-native-nitro-google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.647949159303-53e8cedj7ochfqqhhccc9b9l77jvt7gq"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "現在地の周辺で散歩先のスポットを探すとき、ピンを登録する場所を地図で選ぶとき、散歩のルートを記録するときに位置情報を使います。散歩の記録中は、画面のロック中や他のアプリの使用中も位置情報を取得し、散歩を終了すると取得を止めます。",
          "locationAlwaysAndWhenInUsePermission": "現在地の周辺で散歩先のスポットを探すとき、ピンを登録する場所を地図で選ぶとき、散歩のルートを記録するときに位置情報を使います。散歩の記録中は、画面のロック中や他のアプリの使用中も位置情報を取得し、散歩を終了すると取得を止めます。",
          "locationAlwaysPermission": "現在地の周辺で散歩先のスポットを探すとき、ピンを登録する場所を地図で選ぶとき、散歩のルートを記録するときに位置情報を使います。散歩の記録中は、画面のロック中や他のアプリの使用中も位置情報を取得し、散歩を終了すると取得を止めます。",
          "motionUsagePermission": "このアプリはモーションとフィットネスのデータを使用しません。歩数は記録した距離から推定しています。",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": true,
          "androidForegroundServiceIcon": "./assets/app-icons/android/adaptive-monochrome.png"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ピンに写真を添付するために写真ライブラリを利用します。",
          "cameraPermission": "ピンに添付する写真を撮影するためにカメラを利用します。",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3c6c2a8d-fd2b-44a4-b2e7-2d13ab777ea7"
      }
    },
    "owner": "tristar2nd",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3c6c2a8d-fd2b-44a4-b2e7-2d13ab777ea7"
    }
  }
}
