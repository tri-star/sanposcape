{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "import"],
  "env": {
    "es2024": true,
    "node": true
  },
  "ignorePatterns": [
    "src/api/generated/**",
    "dist/**",
    ".expo/**",
    "node_modules/**",
    "docs/mock/**"
  ],
  "rules": {
    "no-unused-vars": "error",
    "eqeqeq": "error",
    // oxlint 1.79.0 で react プラグインに追加された React Compiler 由来のルール。
    // React Native の `useRef(new Animated.Value(...)).current` は公式イディオムだが
    // レンダー中の ref アクセスとして必ず検出されるうえ、
    // 「最新のコールバックを毎レンダー ref に載せる」手法（useScreenBack / useWalkDelete）も
    // 同様に検出される。このリポジトリでは意図的に使っている手法なので無効化する。
    "react/refs": "off"
  },
  "overrides": [
    {
      "files": ["src/features/walk/**", "src/features/history/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/services/auth", "@/services/auth/*", "@/store/useAuthSessionStore"],
                "message": "探索・散歩・履歴のロジックは認証状態に依存させない（SS-13 / ADR-009）。認証トークンは customFetch が @/api/authTokenProvider 経由で付与する。"
              }
            ]
          }
        ]
      }
    }
  ]
}
