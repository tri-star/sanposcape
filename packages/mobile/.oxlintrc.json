{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "import"],
  "env": {
    "es2024": true,
    "node": true
  },
  "ignorePatterns": [
    "src/api/generated/**",
    "dist/**",
    ".expo/**",
    "node_modules/**",
    "docs/mock/**"
  ],
  "rules": {
    "no-unused-vars": "error",
    "eqeqeq": "error",
    // oxlint 1.79.0 で react プラグインに追加された React Compiler 由来のルール。
    // React Native の `useRef(new Animated.Value(...)).current` は公式イディオムだが
    // レンダー中の ref アクセスとして必ず検出されるうえ、
    // 「最新のコールバックを毎レンダー ref に載せる」手法（useScreenBack / useWalkDelete）も
    // 同様に検出される。このリポジトリでは意図的に使っている手法なので無効化する。
    "react/refs": "off"
  },
  "overrides": [
    {
      "files": ["src/features/walk/**", "src/features/history/**", "src/features/pin/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/services/auth", "@/services/auth/*", "@/store/useAuthSessionStore"],
                "message": "探索・散歩・履歴・ピン登録のロジックは認証状態に依存させない（SS-13 / SS-88 / ADR-009）。認証済みかどうかはルート（app/）が useAuthSessionStore から読み、props で注入する。認証トークンは customFetch が @/api/authTokenProvider 経由で付与する。"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/lib/**",
        "src/api/**",
        "src/hooks/**",
        "src/store/**",
        "src/services/**",
        "src/theme/**",
        "src/types/**",
        "src/features/*/lib/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/config/devTools"],
                "message": "@/config/devTools は expo-constants / expo-updates（ネイティブ依存）を読むため Vitest の対象から import してはいけない。開発ツールの可否はルート（app/）が isDevToolsEnabled() で読み、props で注入する（SS-148 / mobile ADR-007）。"
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/features/walk/lib/**",
        "src/features/history/lib/**",
        "src/features/pin/lib/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/services/auth", "@/services/auth/*", "@/store/useAuthSessionStore"],
                "message": "探索・散歩・履歴・ピン登録のロジックは認証状態に依存させない（SS-13 / SS-88 / ADR-009）。認証済みかどうかはルート（app/）が useAuthSessionStore から読み、props で注入する。認証トークンは customFetch が @/api/authTokenProvider 経由で付与する。"
              },
              {
                "group": ["@/config/devTools"],
                "message": "@/config/devTools は expo-constants / expo-updates（ネイティブ依存）を読むため Vitest の対象から import してはいけない。開発ツールの可否はルート（app/）が isDevToolsEnabled() で読み、props で注入する（SS-148 / mobile ADR-007）。"
              }
            ]
          }
        ]
      }
    }
  ]
}
