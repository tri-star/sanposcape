{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_AUTH_MODE": "dev",
        "EXPO_PUBLIC_DEV_USER_KEY": "e2e-user-1",
        "EXPO_PUBLIC_BACKEND_API_URL": "http://10.0.2.2:8000",
        "EXPO_PUBLIC_LOCATION_MODE": "mock"
      }
    },
    "staging": {
      "distribution": "store",
      "channel": "staging",
      "environment": "preview",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_API_URL": "https://app-api.dev.sanposcape.com",
        "EXPO_PUBLIC_AUTH_MODE": "real",
        "EXPO_PUBLIC_LOCATION_MODE": "real"
      }
    },
    "staging-apk": {
      "extends": "staging",
      "distribution": "internal",
      "autoIncrement": false,
      "android": {
        "buildType": "apk"
      }
    },
    "staging-ios": {
      "extends": "staging",
      "distribution": "internal",
      "autoIncrement": false
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_API_URL": "https://app-api.sanposcape.com",
        "EXPO_PUBLIC_AUTH_MODE": "real",
        "EXPO_PUBLIC_LOCATION_MODE": "real"
      }
    }
  },
  "submit": {
    "staging": {},
    "production": {}
  }
}
