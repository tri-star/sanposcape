{
  "name": "mobile",
  "main": "index.ts",
  "version": "0.1.0",
  "dependencies": {
    "@expo/ui": "~57.0.7",
    "@tanstack/react-query": "^5.101.2",
    "expo": "~57.0.7",
    "expo-constants": "~57.0.6",
    "expo-dev-client": "~57.0.7",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-router": "~57.0.7",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-updates": "~57.0.8",
    "expo-web-browser": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-edge-to-edge": "^1.8.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-nitro-modules": "^0.36.1",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-unistyles": "^3.3.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@expo/fingerprint": "^0.20.5",
    "@faker-js/faker": "^10.5.0",
    "@types/react": "~19.2.2",
    "msw": "^2.15.0",
    "orval": "^8.22.0",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "orval": "orval --config ./orval.config.ts",
    "design:tokens": "tsx scripts/generate-tokens.ts",
    "design:tokens:check": "tsx scripts/generate-tokens.ts && git diff --exit-code -- src/theme/generated && test -z \"$(git status --porcelain -- src/theme/generated)\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt src app scripts index.ts babel.config.js metro.config.js orval.config.ts vitest.config.ts",
    "format:check": "oxfmt --check src app scripts index.ts babel.config.js metro.config.js orval.config.ts vitest.config.ts"
  },
  "private": true
}
