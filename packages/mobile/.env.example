# Expo は EXPO_PUBLIC_ 接頭辞の変数のみクライアントへ公開する
EXPO_PUBLIC_BACKEND_API_URL=http://localhost:{%BACKEND_API_PORT%}

# 認証モード: real | dev | mock（未設定・不正値は real にフォールバック）
#   real = Google サインイン + POST /auth/session
#   dev  = POST /auth/dev-session（backend も AUTH_MODE=dev で起動すること）
#   mock = メモリ上の固定ダミー（vitest 用。実機ビルドでは使わない）
EXPO_PUBLIC_AUTH_MODE=dev

# dev モードで backend に渡す開発用ユーザーキー
EXPO_PUBLIC_DEV_USER_KEY=dev-user-1

# 位置情報モード: real | dev | mock（未設定・不正値は real にフォールバック）
# real = 実機の foreground location permission を使用
# dev / mock = 東京駅周辺の固定座標を返す。development build と単体テスト向け
EXPO_PUBLIC_LOCATION_MODE=dev

# Android Google Maps SDK key。EXPO_PUBLIC_ を付けず、EAS/local build 時のみ注入する。
# Android application restriction を必ず設定し、実キーはこのファイルにも commit しない。
ANDROID_GOOGLE_MAPS_API_KEY=

# Google OAuth クライアントID（秘密情報ではない。client_secret は絶対に置かない）
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
