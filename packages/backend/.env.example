BACKEND_API_PORT={%BACKEND_API_PORT%}
DB_PORT={%DB_PORT%}
# Docker build 時に app_user へ設定する UID/GID。WSL2 では id -u / id -g に合わせる。
APP_UID=1000
APP_GID=1000
DB_USER=app
DB_PASSWORD=password
DB_NAME=app
TEST_DB_NAME=app_test

# 実行環境: local | test | staging | production
# ★ AWS 側のスタックパラメータ Env(dev/prod) はこの ENV とは別物。SAM テンプレートが
#   Env=dev→ENV=staging / Env=prod→ENV=production に変換して渡す（docs/deployment.md 参照）。
ENV=local

# DB 接続 DSN（例: Neon が払い出す postgres://... 形式）。設定するとこちらが優先され、
# 下の DB_HOST 等の組み立ては使われなくなる。ローカル開発では空のままでよい
# （下の DB_HOST 等から postgresql+psycopg://... が組み立てられる）。
# ENV=local/test 以外では必須（Lambda ではシークレットの neon_dsn がここへ渡される）。
# DATABASE_DSN=

# 認証モード: real | dev（コード既定は real = fail-safe）
#   real = POST /auth/session（Google ID token 検証）
#   dev  = 上記に加えて POST /auth/dev-session を有効化（ローカル開発 / Maestro E2E 用）
# ★本番デプロイでは絶対に dev にしない（ENV=production かつ AUTH_MODE!=real は起動失敗する）
AUTH_MODE=dev

# 自前 access token(HS256) の署名鍵。production では 32 文字以上必須
# ローカルは未設定でもダミー鍵にフォールバックする
AUTH_JWT_SECRET=local-development-secret-change-me-please
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30

# Google ID token の許容 audience（カンマ区切り可）
#   Android のネイティブサインインは Web クライアント ID、iOS は iOS クライアント ID が aud になり得る
GOOGLE_ALLOWED_AUDIENCES=

# Maps provider モード: real | fake（コード既定は real = fail-safe）
#   real = Google Maps Platform を実際に呼ぶ（キー未設定なら /explore/* は 503）
#   fake = ネットワークを使わない決定的な provider（Maestro E2E / キーを持たない開発者用）
# ★ENV=local / test 以外で fake にすると起動失敗する（AUTH_MODE と同じ fail-safe 方針）
# MAPS_MODE=real

# Google Maps Platform server key. Restrict this key to Places API (New) and Routes API.
# Never expose this value to the mobile application or commit a real key.
GOOGLE_MAPS_SERVER_API_KEY=
## The remaining Maps settings have safe defaults; override only when needed.
GOOGLE_MAPS_CONNECT_TIMEOUT_SECONDS=3
GOOGLE_MAPS_READ_TIMEOUT_SECONDS=8
GOOGLE_MAPS_CACHE_TTL_SECONDS=300
GOOGLE_MAPS_CACHE_MAX_ENTRIES=256
GOOGLE_MAPS_SEARCH_DEADLINE_SECONDS=10
GOOGLE_MAPS_RATE_LIMIT_REQUESTS=30
GOOGLE_MAPS_ANONYMOUS_RATE_LIMIT_REQUESTS=10
GOOGLE_MAPS_RATE_LIMIT_WINDOW_SECONDS=60
GOOGLE_MAPS_EXPLORE_REQUEST_MAX_BYTES=32768
GOOGLE_MAPS_MAX_PLACE_CANDIDATES=20
GOOGLE_MAPS_MAX_ROUTE_REQUESTS_PER_SEARCH=20

# 周回ルート（/explore/routes/loop）の kill switch。品質劣化時の緊急停止と、
# 「同じ道で戻る」フォールバックを手動で確認したいときに false にする（real/fake 両方で有効）。
GOOGLE_MAPS_LOOP_ROUTE_ENABLED=true
# 周回ルート1リクエスト全体（並列2候補＋同じ道フォールバックの単発取得まで含む）の
# 時間予算（秒）。1候補あたりの上限ではない。Lambda の 29 秒制約より十分短くする。
GOOGLE_MAPS_ROUTE_DEADLINE_SECONDS=12

# フィーチャーフラグモード（AWS AppConfig, SS-98/ADR-008）: real | stub（コード既定は real = fail-safe）
#   real = AppConfig（boto3 appconfigdata）を実際に呼ぶ。APPCONFIG_* を1本でも設定しないと
#          UnconfiguredFlagSource に落ちる（AWS を一切呼ばない安全既定。ローカルではこれで十分）
#   stub = ネットワークを一切使わず FEATURE_FLAG_STUB_DOCUMENT を返す
# ★ENV=local / test 以外で stub にすると起動失敗する（AUTH_MODE / MAPS_MODE と同じ fail-safe 方針）
FEATURE_FLAG_MODE=stub
# stub モードで返す文書。GetLatestConfiguration が返す簡略 JSON と同じ形（本番と同じパーサを通す）。
# pin_registration（ピン登録, SS-88）が最初の実フラグ。ローカル・E2E ではデフォルトで ON。
FEATURE_FLAG_STUB_DOCUMENT={"pin_registration":{"enabled":true}}
# APPCONFIG_* はローカルでは設定しない（real で試したい場合のみ、dev の AppConfig の ID を
# 3本とも設定する。1本でも空だと UnconfiguredFlagSource になる）。
# APPCONFIG_APPLICATION_ID=
# APPCONFIG_ENVIRONMENT_ID=
# APPCONFIG_CONFIGURATION_PROFILE_ID=

# 写真ストレージモード（SS-88）: real | fake（コード既定は real = fail-safe）
#   real = S3 に実際に接続する（PIN_PHOTO_BUCKET_NAME 未設定なら写真 API は 503）
#   fake = ネットワークを使わない開発用の受け口（backend 自身の /dev-storage/*）。
#          ローカル・Maestro E2E ではこれで十分（S3 バケットが無くても写真付きで試せる）
# ★ENV=local / test 以外で fake にすると起動失敗する（AUTH_MODE 等と同じ fail-safe 方針）
STORAGE_MODE=fake
# STORAGE_MODE=fake の保存先（packages/backend からの相対パス。.gitignore 対象）。
# 空にするとプロセス内メモリになり、backend の再起動（--reload 含む）で写真が消える。
DEV_STORAGE_DIR=storages/dev-storage
# 以下は upload の上限値。既定のままで問題なければ設定不要（Settings 側のデフォルトを参照）。
# PIN_PHOTO_MAX_BYTES=10485760
# PIN_PHOTO_USER_QUOTA_BYTES=1073741824

# STORAGE_MODE=real でローカルから dev の実 S3 に繋いで確認したいときだけ設定する
# （presigned POST の直送が端末 → S3 で完結し backend に痕跡が残らないため、
#  実機/エミュレータでの切り分けに使う。docs/local-development.md「実 S3 に繋いで確認する」）。
# 平常のローカル開発は上の STORAGE_MODE=fake のままでよい。
# PIN_PHOTO_BUCKET_NAME=sanposcape-dev-pin-photos-<account_id>
# PIN_PHOTO_BUCKET_REGION=ap-southeast-1
# ★ AWS の認証情報は .env に書かない（一時認証情報は短命で、書くと必ず古くなる）。
#   `aws configure export-credentials --profile <profile> --format env` の出力を
#   シェルで eval してから docker compose を起動すること（compose.yaml が透過させる）。

# アプリケーションログのレベル: DEBUG | INFO | WARNING | ERROR | CRITICAL
# INFO でアクセスログ（1リクエスト1行）が出る。既定は INFO。
# LOG_LEVEL=INFO
