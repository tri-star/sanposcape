BACKEND_API_PORT={%BACKEND_API_PORT%}
DB_PORT={%DB_PORT%}
# Docker build 時に app_user へ設定する UID/GID。WSL2 では id -u / id -g に合わせる。
APP_UID=1000
APP_GID=1000
DB_USER=app
DB_PASSWORD=password
DB_NAME=app
TEST_DB_NAME=app_test

# 実行環境: local | test | staging | production
ENV=local

# 認証モード: real | dev（コード既定は real = fail-safe）
#   real = POST /auth/session（Google ID token 検証）
#   dev  = 上記に加えて POST /auth/dev-session を有効化（ローカル開発 / Maestro E2E 用）
# ★本番デプロイでは絶対に dev にしない（ENV=production かつ AUTH_MODE!=real は起動失敗する）
AUTH_MODE=dev

# 自前 access token(HS256) の署名鍵。production では 32 文字以上必須
# ローカルは未設定でもダミー鍵にフォールバックする
AUTH_JWT_SECRET=local-development-secret-change-me-please
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30

# Google ID token の許容 audience（カンマ区切り可）
#   Android のネイティブサインインは Web クライアント ID、iOS は iOS クライアント ID が aud になり得る
GOOGLE_ALLOWED_AUDIENCES=
