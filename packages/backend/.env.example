BACKEND_API_PORT={%BACKEND_API_PORT%}
DB_PORT={%DB_PORT%}
# Docker build 時に app_user へ設定する UID/GID。WSL2 では id -u / id -g に合わせる。
APP_UID=1000
APP_GID=1000
DB_USER=app
DB_PASSWORD=password
DB_NAME=app
TEST_DB_NAME=app_test

# 実行環境: local | test | staging | production
# ★ AWS 側のスタックパラメータ Env(dev/prod) はこの ENV とは別物。SAM テンプレートが
#   Env=dev→ENV=staging / Env=prod→ENV=production に変換して渡す（docs/deployment.md 参照）。
ENV=local

# DB 接続 DSN（例: Neon が払い出す postgres://... 形式）。設定するとこちらが優先され、
# 下の DB_HOST 等の組み立ては使われなくなる。ローカル開発では空のままでよい
# （下の DB_HOST 等から postgresql+psycopg://... が組み立てられる）。
# ENV=local/test 以外では必須（Lambda ではシークレットの neon_dsn がここへ渡される）。
# DATABASE_DSN=

# 認証モード: real | dev（コード既定は real = fail-safe）
#   real = POST /auth/session（Google ID token 検証）
#   dev  = 上記に加えて POST /auth/dev-session を有効化（ローカル開発 / Maestro E2E 用）
# ★本番デプロイでは絶対に dev にしない（ENV=production かつ AUTH_MODE!=real は起動失敗する）
AUTH_MODE=dev

# 自前 access token(HS256) の署名鍵。production では 32 文字以上必須
# ローカルは未設定でもダミー鍵にフォールバックする
AUTH_JWT_SECRET=local-development-secret-change-me-please
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30

# Google ID token の許容 audience（カンマ区切り可）
#   Android のネイティブサインインは Web クライアント ID、iOS は iOS クライアント ID が aud になり得る
GOOGLE_ALLOWED_AUDIENCES=

# Maps provider モード: real | fake（コード既定は real = fail-safe）
#   real = Google Maps Platform を実際に呼ぶ（キー未設定なら /explore/* は 503）
#   fake = ネットワークを使わない決定的な provider（Maestro E2E / キーを持たない開発者用）
# ★ENV=local / test 以外で fake にすると起動失敗する（AUTH_MODE と同じ fail-safe 方針）
# MAPS_MODE=real

# Google Maps Platform server key. Restrict this key to Places API (New) and Routes API.
# Never expose this value to the mobile application or commit a real key.
GOOGLE_MAPS_SERVER_API_KEY=
## The remaining Maps settings have safe defaults; override only when needed.
GOOGLE_MAPS_CONNECT_TIMEOUT_SECONDS=3
GOOGLE_MAPS_READ_TIMEOUT_SECONDS=8
GOOGLE_MAPS_CACHE_TTL_SECONDS=300
GOOGLE_MAPS_CACHE_MAX_ENTRIES=256
GOOGLE_MAPS_SEARCH_DEADLINE_SECONDS=10
GOOGLE_MAPS_RATE_LIMIT_REQUESTS=30
GOOGLE_MAPS_ANONYMOUS_RATE_LIMIT_REQUESTS=10
GOOGLE_MAPS_RATE_LIMIT_WINDOW_SECONDS=60
GOOGLE_MAPS_EXPLORE_REQUEST_MAX_BYTES=32768
GOOGLE_MAPS_MAX_PLACE_CANDIDATES=20
GOOGLE_MAPS_MAX_ROUTE_REQUESTS_PER_SEARCH=20
