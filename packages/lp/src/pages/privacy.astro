---
import BaseLayout from "../layouts/BaseLayout.astro";

// お問い合わせ窓口。開示等の請求もここで受け付ける。
const contactEmail = "support@sanposcape.com";
// 制定日は変えない。本文を改定したら revisedOn を更新する（改定の告知は「12. 本ポリシーの変更」）。
const enactedOn = "2026年10月3日";
const revisedOn: string | undefined = undefined;

// URL（/privacy/）はアプリ内のリンクと App Store Connect に登録するため変えないこと。

// 「3. 外部サービスへの送信」の表。App Store Connect の App Privacy の申告（SS-159）と食い違わないようにする。
const externalServices = [
  {
    provider: "Google LLC（米国）: Google でサインイン",
    purpose: "サインイン",
    data: "サインインの手続きは端末と Google の間で行われ、運営者は 1-2 の情報を受け取ります",
  },
  {
    provider:
      "Google LLC（米国）: Google Maps Platform の Places API・Routes API",
    purpose: "スポットの検索、徒歩ルートの計算",
    data: "丸めた現在地、目的地や経由地の位置。運営者のサーバーから送信し、利用者を識別する情報は送りません",
  },
  {
    provider: "Google LLC（米国）: Google Maps SDK for Android",
    purpose: "Android 版での地図の表示",
    data: "地図データの要求（表示している範囲の位置）、IP アドレス、端末・OS の情報など。端末から直接送信します",
  },
  {
    provider: "Apple Inc.（米国）: マップ",
    purpose: "iPhone 版での地図の表示",
    data: "地図データの要求（表示している範囲の位置）、IP アドレス、端末・OS の情報など。端末から直接送信します",
  },
  {
    provider: "Amazon Web Services, Inc.（米国）",
    purpose: "サーバーの運用、写真の保存",
    data: "本アプリが送信する情報（シンガポールのリージョンで保管）",
  },
  {
    provider: "Neon（米国の事業者）: データベースサービス",
    purpose: "データベース",
    data: "アカウント情報、散歩の記録、ピンなど（シンガポールのリージョンで保管）",
  },
  {
    provider: "650 Industries, Inc.（米国）: Expo",
    purpose: "アプリの更新の配信",
    data: "更新を確認するため、アプリのバージョン、端末の OS の種類、インストールごとに生成される識別子などを端末から直接送信します",
  },
];
---

<BaseLayout
  title="プライバシーポリシー — Sanposcape"
  description="散歩アプリ Sanposcape における位置情報などの利用者情報の取り扱いについて定めたプライバシーポリシーです。"
>
  <article class="legal container" aria-labelledby="legal-title">
    <header class="legal-header">
      <p class="eyebrow">PRIVACY POLICY</p>
      <h1 id="legal-title">プライバシーポリシー</h1>
      <p class="legal-date">
        制定日: {enactedOn}
        {revisedOn && <span>／最終改定日: {revisedOn}</span>}
      </p>
    </header>

    <p>
      Sanposcape
      運営者（以下「運営者」といいます）は、散歩アプリ「Sanposcape」（以下「本アプリ」といいます）および紹介サイト（sanposcape.com）における、利用者の情報の取り扱いについて、以下のとおりプライバシーポリシー（以下「本ポリシー」といいます）を定めます。本アプリは、日本国内での利用を前提として提供しています。
    </p>

    <nav class="legal-toc" aria-labelledby="legal-toc-title">
      <h2 id="legal-toc-title">目次</h2>
      <ol>
        <li>
          <a href="#collect">取得する情報</a>
        </li>
        <li>
          <a href="#purpose">利用目的</a>
        </li>
        <li>
          <a href="#services">外部サービスへの送信</a>
        </li>
        <li>
          <a href="#third-party">第三者への提供</a>
        </li>
        <li>
          <a href="#overseas">外国でのデータの保管</a>
        </li>
        <li>
          <a href="#retention">保存期間</a>
        </li>
        <li>
          <a href="#delete">情報の削除方法</a>
        </li>
        <li>
          <a href="#withdraw">位置情報などの利用の停止（同意の撤回）</a>
        </li>
        <li>
          <a href="#security">安全管理のための措置</a>
        </li>
        <li>
          <a href="#requests">開示などのご請求</a>
        </li>
        <li>
          <a href="#minors">未成年の方の利用</a>
        </li>
        <li>
          <a href="#changes">本ポリシーの変更</a>
        </li>
        <li>
          <a href="#contact">運営者・お問い合わせ窓口</a>
        </li>
      </ol>
    </nav>

    <section aria-labelledby="collect">
      <h2 id="collect">1. 取得する情報</h2>

      <h3>1-1. 位置情報（正確な位置情報と散歩の軌跡）</h3>
      <p>
        本アプリは、端末の GPS
        などによる正確な位置情報を、次の場面で取得します。位置情報の利用許可は「アプリの使用中」のみをお願いしており、現在、「常に許可」は求めていません。
      </p>
      <ul>
        <li>
          <strong>散歩先のスポットやルートを探すとき</strong>: 現在地を 10m
          程度の単位に丸めて運営者のサーバーへ送信します。丸めるのは同じ問い合わせの結果を再利用しやすくするためで、位置を分からなくするための処理ではありません。サインインしていない場合も送信します。サーバーは提案の作成にだけ使い、データベースには保存しません（6
          のとおり、短時間だけ一時的に保持します）。
        </li>
        <li>
          <strong>散歩中</strong>:
          散歩を開始してから終了するまで、一定の距離を移動するごとに位置を記録します。アプリをバックグラウンドに移したり画面をロックしたりしても、散歩を終了するまで記録を続けます。アプリを終了（最近使ったアプリの一覧から消去）すると記録は止まり、その散歩は保存されません。記録中は、iPhone
          ではステータスバーの表示、Android
          では通知で、記録していることが分かるようにしています。散歩を終了すると記録は止まります。
        </li>
        <li>
          <strong>地図に現在地を表示するとき</strong>:
          端末の中で現在地を表示するために使います。
        </li>
        <li>
          <strong>ピンの地図を表示するとき</strong>:
          現在地の周辺など、地図に表示している範囲（丸めた緯度・経度の範囲）を、その範囲のピンを取り出すためにサーバーへ送信します。データベースには保存しませんが、送信した範囲はアクセスに伴う情報（1-5）の一部として記録に残ります。
        </li>
      </ul>
      <p>
        サインインした状態で散歩を終えると、散歩の記録として、軌跡（位置の並び）、開始・終了の日時、歩いた時間と距離、目的地（名称・位置・Google
        の場所
        ID）をサーバーに保存します。サインインしていない間に歩いた散歩は、サーバーに保存しません。散歩の終了後に「サインインして保存」を選んだ場合に限り、その散歩を保存します。
      </p>

      <h3>1-2. アカウント情報</h3>
      <p>
        Google アカウントでサインインしたときに、Google
        から受け取る次の情報を保存します。サインインのたびに最新の内容に更新します。
      </p>
      <ul>
        <li>Google アカウントを識別するための ID</li>
        <li>メールアドレス</li>
        <li>表示名</li>
        <li>プロフィール画像の URL</li>
      </ul>

      <h3>1-3. 利用者が登録する情報</h3>
      <ul>
        <li>
          ピン（お気に入りの場所）の名称・メモ・位置・タグ、ピンをまとめる地図の名称
        </li>
        <li>
          ピンに添付する写真。写真は端末で縮小・再圧縮してから送信するため、撮影位置などの付加情報（Exif）は送信しません。
        </li>
      </ul>
      <p>
        写真の添付のため、カメラで撮影するときにはカメラの利用許可をお願いします。写真ライブラリからは、端末の写真選択画面で利用者が選んだ写真だけを受け取ります。
      </p>
      <p>
        ピン、写真、散歩の記録は、現在、ご本人だけが見られます。ほかの利用者や一般には公開されません。地図を共有する機能などを追加する場合は、共有相手に見える情報を本ポリシーに明記し、事前にお知らせします。
      </p>

      <h3>1-4. ログイン状態を保つための情報</h3>
      <p>
        サインインの状態を保つための認証情報（トークン）を、端末の安全な保存領域（iOS
        のキーチェーン、Android
        のキーストア）に保存します。サーバーには、照合のための変換値（ハッシュ値）だけを保存します。
      </p>

      <h3>1-5. アクセスに伴う情報</h3>
      <p>
        本アプリや紹介サイトからサーバーへアクセスがあったとき、IP
        アドレス、アクセスの日時、リクエストの種類（URL。地図の表示範囲などを含むことがあります）と処理の結果、ブラウザやアプリの種類、アカウントの内部
        ID
        などが記録されます。散歩の軌跡やピンの名称・メモなどの入力内容は、原則としてこの記録に含めません。ただし、障害が発生した際の調査用の記録に含まれることがあります（保存期間は
        6 のとおりです）。
      </p>

      <h3>1-6. 取得しない情報</h3>
      <ul>
        <li>
          本アプリと紹介サイトは、現在、広告、アクセス解析、クラッシュ解析のためのツールを組み込んでいません。紹介サイトは
          Cookie を使用していません。
        </li>
        <li>
          現在、他社のアプリやウェブサイトをまたいで利用者を追跡すること（トラッキング）は行っておらず、広告識別子も取得していません。
        </li>
        <li>連絡先、マイク、健康情報などにはアクセスしていません。</li>
      </ul>
      <p>
        これらのツールの導入など、取得する情報を変更する場合は、事前に本ポリシーを改定します。
      </p>
    </section>

    <section aria-labelledby="purpose">
      <h2 id="purpose">2. 利用目的</h2>
      <p>取得した情報は、次の目的に限って利用します。</p>
      <ul>
        <li>散歩先のスポットや、散歩のルートを提案するため</li>
        <li>散歩の軌跡・時間・距離を記録し、履歴として表示するため</li>
        <li>ピンや写真を保存し、地図に表示するため</li>
        <li>サインインの受け付け、本人の確認、アカウントの管理のため</li>
        <li>不正な利用の防止、障害の調査と対応、セキュリティの確保のため</li>
        <li>
          本アプリの利用規約などのルールに違反する行為への対応、法令に基づく要請への対応のため
        </li>
        <li>
          本アプリに関する重要なお知らせ（仕様の変更、本ポリシーの改定、サービスの終了、セキュリティに関するお知らせなど）を連絡するため
        </li>
        <li>本アプリの改善や新しい機能の開発のため</li>
        <li>個人を識別できない形に加工した統計情報を作成するため</li>
        <li>お問い合わせや開示などのご請求に対応するため</li>
      </ul>
      <p>
        現在、位置情報を含む利用者の情報を、広告の配信や、他社が持つ情報と組み合わせた分析に利用していません。利用目的を変更する場合は、事前に本ポリシーを改定し、法令上必要な場合はあらためて同意をいただきます。
      </p>
    </section>

    <section aria-labelledby="services">
      <h2 id="services">3. 外部サービスへの送信</h2>
      <p>
        本アプリの提供のため、次の事業者のサービスを利用しています。Google Maps
        Platform、Amazon Web Services、Neon
        は、運営者に代わって情報を処理させるか、運営者が管理する情報の保管場所として利用しています。端末から各社へ直接送信される情報（Google
        でサインイン、地図の表示、Expo）は、各社のプライバシーポリシーに従って取り扱われます。
      </p>
      <div class="legal-table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">事業者・サービス</th>
              <th scope="col">用途</th>
              <th scope="col">送信される情報</th>
            </tr>
          </thead>
          <tbody>
            {externalServices.map((service) => (
              <tr>
                <td data-label="事業者・サービス">{service.provider}</td>
                <td data-label="用途">{service.purpose}</td>
                <td data-label="送信される情報">{service.data}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p>
        Google の情報の取り扱いは
        <a
          href="https://policies.google.com/privacy?hl=ja"
          rel="noopener noreferrer"
        >
          Google プライバシーポリシー
        </a>
        をご覧ください。
      </p>
    </section>

    <section aria-labelledby="third-party">
      <h2 id="third-party">4. 第三者への提供</h2>
      <p>
        運営者は、次の場合を除き、利用者の同意を得ずに個人情報を第三者に提供しません。個人情報を販売することもありません。
      </p>
      <ul>
        <li>法令に基づく場合</li>
        <li>
          人の生命、身体または財産の保護のために必要がある場合で、利用者の同意を得ることが困難なとき
        </li>
      </ul>
      <p>
        また、本アプリの運営を他の者に引き継ぐ場合は、引き継ぎ後も本ポリシーの範囲内で利用者の情報を取り扱い、事前にお知らせします。
      </p>
    </section>

    <section aria-labelledby="overseas">
      <h2 id="overseas">5. 外国でのデータの保管</h2>
      <p>
        サーバーとデータベースはシンガポールにあり、利用者の情報はシンガポールで保管されます。シンガポールには、個人情報の保護に関する法律として
        Personal Data Protection Act 2012 があります。また、3
        の事業者はいずれも米国の事業者で、Google の Places API・Routes API
        への送信など、米国で処理される情報があります。米国には、連邦法として包括的な個人情報保護法はなく、分野ごとの連邦法と州法（カリフォルニア州消費者プライバシー法など）があります。各国の個人情報の保護に関する制度は、個人情報保護委員会が公表している
        <a
          href="https://www.ppc.go.jp/personalinfo/legal/kaiseihogohou/#gaikoku"
          rel="noopener noreferrer"
        >
          外国における個人情報の保護に関する制度等の調査
        </a>
        で確認できます。
      </p>
    </section>

    <section aria-labelledby="retention">
      <h2 id="retention">6. 保存期間</h2>
      <ul>
        <li>
          <strong>アカウント情報、散歩の記録、ピン、写真</strong>:
          利用者が削除するか、アカウントを削除するまで保存します（アカウントを削除したときの写真の扱いは
          7 のとおりです）。
        </li>
        <li>
          <strong>スポットやルートを探すときに送信された現在地</strong>:
          データベースには保存しません。同じ問い合わせに再利用するため、サーバーのメモリ上に短時間（数分程度）一時的に保持し、その後は利用しません（サーバーの再起動などでメモリから消えます）。
        </li>
        <li>
          <strong>散歩中に端末に一時保存する位置</strong>:
          散歩の終了時、またはアプリの次回起動時に端末から消去します。
        </li>
        <li>
          <strong>アクセスに伴う情報（1-5）</strong>:
          不正利用の防止と障害対応のために最長 400
          日保存し、期間の経過後に削除します。障害の調査用の記録も同じです。アカウントを削除した場合も、この期間は保存されます。
        </li>
      </ul>
      <p>
        削除した情報は、障害に備えたバックアップに一定期間残ることがありますが、バックアップの保存期間の経過とともに消去されます。
      </p>
      <p>
        ただし、法令に基づいて保存が必要な場合や、不正な利用の調査・防止のために必要な場合は、必要な範囲と期間に限り、削除の後も情報を保存することがあります。
      </p>
      <p>
        本アプリの提供を終了する場合は、相当の期間をおいて事前にお知らせし、終了後、相当の期間内に保存している情報を削除します。終了に先立って散歩の記録などを書き出す手段を用意する場合は、お知らせの際にご案内します。
      </p>
    </section>

    <section aria-labelledby="delete">
      <h2 id="delete">7. 情報の削除方法</h2>
      <ul>
        <li>
          <strong>散歩の記録</strong>:
          アプリの「アカウント」タブの「最近の散歩」（「すべて見る」から全件）で散歩を選び、「この散歩の記録を削除」から
          1 件ずつ削除できます。
        </li>
        <li>
          <strong>ピン・写真</strong>:
          ピンの詳細画面の「このピンを削除」から削除できます。写真はピンの編集画面から
          1
          枚ずつ削除できます。ピンや写真を削除すると、保存している写真の画像ファイルもあわせて削除します（処理の都合上、まれに画像ファイルが保存領域に残ることがあります）。
        </li>
        <li>
          <strong>アカウント</strong>: アプリの「アカウント」タブ
          →「設定」の「アカウントを削除」から削除できます。アカウント情報とあわせて、散歩の記録、ピンなど、アカウントに関連する情報を削除します。
        </li>
      </ul>
      <p>
        ただし、現在の仕組みでは、アカウントを削除しても、ピンに添付した写真の画像ファイルは保存領域から自動では削除されず、残ります。写真を表示するための情報は削除されるため、アプリから写真を見ることはできなくなります。画像ファイルも削除したい場合は、アカウントを削除する前に、上の方法でピンや写真を削除してください。
      </p>
      <p>
        アプリから削除できない場合（アプリを削除済みの場合など）は、10 の方法で
        <a href="#contact">お問い合わせ窓口</a>からご依頼いただけます。
      </p>
    </section>

    <section aria-labelledby="withdraw">
      <h2 id="withdraw">8. 位置情報などの利用の停止（同意の撤回）</h2>
      <p>
        位置情報やカメラの利用許可は、端末の設定からいつでも取り消せます。取り消した場合、スポットを探す機能や散歩を記録する機能など、位置情報を使う機能は利用できなくなります。
      </p>
      <ul>
        <li>
          <strong>iPhone</strong>:
          「設定」→「プライバシーとセキュリティ」→「位置情報サービス」→「sanposcape」で「なし」を選びます（iOS
          のバージョンによって名称が異なる場合があります）。
        </li>
        <li>
          <strong>Android</strong>:
          「設定」→「アプリ」→「sanposcape」→「権限」→「位置情報」で「許可しない」を選びます（機種や
          Android のバージョンによって名称が異なる場合があります）。
        </li>
      </ul>
      <p>
        散歩中の位置の記録は、アプリで散歩を終了するといつでも止められます。Google
        アカウントとの連携は、Google
        アカウントの設定画面からも解除できます（解除しても、運営者が保存している情報は削除されません。削除は
        7 の方法で行ってください）。
      </p>
    </section>

    <section aria-labelledby="security">
      <h2 id="security">9. 安全管理のための措置</h2>
      <p>
        運営者は、取得した情報の漏えいや紛失を防ぐため、次の措置を講じています。
      </p>
      <ul>
        <li>
          <strong>基本方針・取扱いのルール</strong>:
          本ポリシーを基本方針とし、取得・利用・保存・削除の各段階での取り扱い方法を定めています。
        </li>
        <li>
          <strong>組織的・人的な措置</strong>:
