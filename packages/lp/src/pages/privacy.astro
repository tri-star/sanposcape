---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/legal.css";

// お問い合わせ窓口。開示等の請求もここで受け付ける。
const contactEmail = "support@sanposcape.com";
// 制定日は変えない。本文を改定したら revisedOn を更新する（改定の告知は「12. 本ポリシーの変更」）。
// 本文はサポート中のすべてのアプリの挙動の和集合で書き、利用者に不利な改定は施行日を付けて事前に公開する
// （docs/privacy/data-inventory.md の 2.1・2.2、手順は packages/lp/AGENTS.md の「改定の手順」）。
const enactedOn = "2026年10月3日";
const revisedOn: string | undefined = "2026年11月2日";
// 施行日。利用者に不利な改定のときだけ付ける（公開から 30 日後が目安。台帳の 2.2）。
// 施行日を過ぎた後に不利でない改定で revisedOn を更新するときは undefined に戻す（冒頭の案内が消える。経緯は改定履歴に残る）。
const effectiveOn: string | undefined = "2026年12月2日";
// 施行日の前日まで適用する改定前の版。effectiveOn と組で、src/pages/privacy/<YYYY-MM-DD>.astro に固定してある。
const previousVersion = {
  href: "/privacy/2026-10-24/",
  appliesUntil: "2026年12月1日",
};

// 末尾の「改定履歴」。不利な改定（施行日を付けた改定）を新しい順に載せる。それより前の改定は git の履歴にある。
const revisionHistory = [
  {
    revisedOn: "2026年11月2日",
    effectiveOn: "2026年12月2日",
    summary:
      "地図の共有（招待）の機能について、メンバーなどに見える情報（1-8）、招待の情報の保存期間（6）、地図から抜けたときやアカウントを削除したときの扱い（7）を追加しました。",
    previousHref: "/privacy/2026-10-24/",
    previousLabel: "改定前の版（2026年10月24日改定）",
  },
];

// URL（/privacy/）はアプリ内のリンクと App Store Connect に登録するため変えないこと。

// 「3. 外部サービスへの送信」の表。App Store Connect の App Privacy の申告（docs/app-privacy-label.md）と食い違わないようにする。
const externalServices = [
  {
    provider: "Google LLC（米国）: Google でサインイン",
    purpose: "サインイン",
    data: "サインインの手続きは端末と Google の間で行われ、運営者は 1-2 の情報を受け取ります。このとき、アプリに組み込んだ Google の部品（SDK）が、端末の識別子、おおよその位置、サインイン機能の利用状況などを Google へ直接送信することがあります（iPhone 版。Google が公表している内容によります）",
  },
  {
    provider: "Apple Inc.（米国）: Apple でサインイン",
    purpose: "サインイン（iPhone 版）、アカウント削除時の連携の解除",
    data: "サインインの手続きは端末と Apple の間で行われ、運営者は 1-2 の情報を受け取ります。運営者のサーバーは、アカウントの削除時に連携を解除するためのトークン（1-4）を受け取るために、サインインの際に端末から受け取った認可コードを、アカウントの削除時にそのトークンを、Apple へ送信します",
  },
  {
    provider:
      "Google LLC（米国）: Google Maps Platform の Places API・Routes API・Geocoding API",
    purpose:
      "スポットの検索、徒歩ルートの計算、ピンの位置の住所の取得（ピンを登録するときの名前の候補、ピンの詳細での表示）",
    data: "丸めた現在地、目的地や経由地の位置、ピンの位置。運営者のサーバーから送信し、利用者を識別する情報は送りません",
  },
  {
    provider: "Google LLC（米国）: Google Maps SDK for Android",
    purpose: "Android 版での地図の表示",
    data: "地図データの要求（表示している範囲の位置）、IP アドレス、端末・OS の情報など。端末から直接送信します",
  },
  {
    provider: "Apple Inc.（米国）: マップ",
    purpose: "iPhone 版での地図の表示",
    data: "地図データの要求（表示している範囲の位置）、IP アドレス、端末・OS の情報など。端末から直接送信します",
  },
  {
    provider: "Amazon Web Services, Inc.（米国）",
    purpose:
      "サーバーの運用、写真の保存、お問い合わせのメールの受信と返信の送信",
    data: "本アプリが送信する情報、お問い合わせのメール（1-6。いずれもシンガポールのリージョンで保管）",
  },
  {
    provider: "Neon（米国の事業者）: データベースサービス",
    purpose: "データベース",
    data: "アカウント情報、散歩の記録、ピンなど（シンガポールのリージョンで保管）",
  },
  {
    provider: "Google LLC（米国）: Gmail",
    purpose: "お問い合わせのメールの保管と返信（運営者の受信箱）",
    data: "お問い合わせのメール（1-6）と、運営者からの返信",
  },
  {
    provider: "650 Industries, Inc.（米国）: Expo",
    purpose: "アプリの更新の配信",
    data: "更新を確認するため、アプリのバージョン、端末の OS の種類、インストールごとに生成される識別子、前回の起動時に発生したエラーの内容などを端末から直接送信します",
  },
];
---

<BaseLayout
  title="プライバシーポリシー — Sanposcape"
  description="散歩アプリ Sanposcape における位置情報などの利用者情報の取り扱いについて定めたプライバシーポリシーです。"
>
  <article class="legal container" aria-labelledby="legal-title">
    <header class="legal-header">
      <p class="eyebrow">PRIVACY POLICY</p>
      <h1 id="legal-title">プライバシーポリシー</h1>
      <p class="legal-date">
        制定日: {enactedOn}
        {revisedOn && <span>／最終改定日: {revisedOn}</span>}
        {effectiveOn && <span>／施行日: {effectiveOn}</span>}
      </p>
    </header>

    {effectiveOn && (
      <p class="legal-notice">
        この版は {effectiveOn} から適用します。{previousVersion.appliesUntil}
        までは<a href={previousVersion.href}>改定前の版</a>
        が適用されます。改定の内容は<a href="#history">改定履歴</a>
        をご覧ください。
      </p>
    )}

    <p>
      Sanposcape
      運営者（以下「運営者」といいます）は、散歩アプリ「Sanposcape」（以下「本アプリ」といいます）および紹介サイト（sanposcape.com）における、利用者の情報の取り扱いについて、以下のとおりプライバシーポリシー（以下「本ポリシー」といいます）を定めます。本アプリは、日本国内での利用を前提として提供しています。本アプリの利用条件は
      <a href="/terms/">利用規約</a>で定めています。
    </p>

    <nav class="legal-toc" aria-labelledby="legal-toc-title">
      <h2 id="legal-toc-title">目次</h2>
      <ol>
        <li>
          <a href="#collect">取得する情報</a>
        </li>
        <li>
          <a href="#purpose">利用目的</a>
        </li>
        <li>
          <a href="#services">外部サービスへの送信</a>
        </li>
        <li>
          <a href="#third-party">第三者への提供</a>
        </li>
        <li>
          <a href="#overseas">外国でのデータの保管</a>
        </li>
        <li>
          <a href="#retention">保存期間</a>
        </li>
        <li>
          <a href="#delete">情報の削除方法</a>
        </li>
        <li>
          <a href="#withdraw">位置情報などの利用の停止（同意の撤回）</a>
        </li>
        <li>
          <a href="#security">安全管理のための措置</a>
        </li>
        <li>
          <a href="#requests">開示などのご請求</a>
        </li>
        <li>
          <a href="#minors">未成年の方の利用</a>
        </li>
        <li>
          <a href="#changes">本ポリシーの変更</a>
        </li>
        <li>
          <a href="#contact">運営者・お問い合わせ窓口</a>
        </li>
      </ol>
      <p class="legal-toc-extra">
        <a href="#history">改定履歴</a>
      </p>
    </nav>

    <section aria-labelledby="collect">
      <h2 id="collect">1. 取得する情報</h2>

      <h3>1-1. 位置情報（正確な位置情報と散歩の軌跡）</h3>
      <p>
        本アプリは、端末の GPS
        などによる正確な位置情報を、次の場面で取得します。位置情報の利用許可は「アプリの使用中」のみをお願いしており、現在、「常に許可」は求めていません。
      </p>
      <ul>
        <li>
          <strong>散歩先のスポットやルートを探すとき</strong>: 現在地を 10m
          程度の単位に丸めて運営者のサーバーへ送信します。丸めるのは同じ問い合わせの結果を再利用しやすくするためで、位置を分からなくするための処理ではありません。サインインしていない場合も送信します。サーバーは提案の作成にだけ使い、データベースには保存しません（6
          のとおり、短時間だけ一時的に保持します）。
        </li>
        <li>
          <strong>散歩中</strong>:
          散歩を開始してから終了するまで、一定の距離を移動するごとに位置を記録します。アプリをバックグラウンドに移したり画面をロックしたりしても、散歩を終了するまで記録を続けます。アプリを終了（最近使ったアプリの一覧から消去）すると記録は止まり、その散歩は保存されません。記録中は、iPhone
          ではステータスバーの表示、Android
          では通知で、記録していることが分かるようにしています。散歩を終了すると記録は止まります。
        </li>
        <li>
          <strong>地図に現在地を表示するとき</strong>:
          端末の中で現在地を表示するために使います。あわせて、端末のセンサーで向いている方角を取得し、現在地の向きとして表示します。方角は送信・保存しません。
        </li>
        <li>
          <strong>ピンを登録するとき</strong>:
          ピンの位置の近くにある駅を調べ、その駅名をタグの候補として登録画面に入れておくために、ピンの位置を運営者のサーバーへ送信します。駅は運営者のサーバーが持つ駅のデータから調べ、ほかの事業者へは送信しません。送信した位置はデータベースにも記録にも保存しません。駅名のタグは、外さずにピンを保存した場合に限り、ピンのタグとして保存します。
        </li>
        <li>
          <strong>ピンの地図を表示するとき</strong>:
          現在地の周辺など、地図に表示している範囲（丸めた緯度・経度の範囲）を、その範囲のピンを取り出すためにサーバーへ送信します。データベースには保存しませんが、送信した範囲はアクセスに伴う情報（1-5）の一部として記録に残ります。
        </li>
      </ul>
      <p>
        サインインした状態で散歩を終えると、散歩の記録として、軌跡（位置の並び）、開始・終了の日時、歩いた時間と距離、目的地（名称・位置・Google
        の場所
        ID）をサーバーに保存します。サインインしていない間に歩いた散歩は、サーバーに保存しません。散歩の終了後に「サインインして保存」を選んだ場合に限り、その散歩を保存します。
      </p>

      <h3>1-2. アカウント情報</h3>
      <p>
        本アプリには、Google アカウントまたは Apple アカウント（iPhone
        版のみ）でサインインします。サインインしたときに、各社から受け取る次の情報を保存します。
      </p>
      <ul>
        <li>
          <strong>Google でサインインした場合</strong>: Google
          アカウントを識別するための
          ID、メールアドレス、表示名、プロフィール画像の
          URL。サインインのたびに最新の内容に更新します。
        </li>
        <li>
          <strong>Apple でサインインした場合</strong>: Apple
          アカウントを識別するための
          ID、メールアドレス、氏名。メールアドレスは、サインインの際に「メールを非公開」を選んだ場合は、Apple
          が発行する転送用のアドレスになり、サインインのたびに最新の内容に更新します。氏名は、初めてサインインしたときに端末から受け取り、表示名が未設定の場合にだけ保存します。あわせて、アカウントを削除するときに
          Apple との連携を解除するため、Apple
          から受け取る認証情報を保存します（1-4）。
        </li>
      </ul>

      <h3>1-3. 利用者が登録する情報</h3>
      <ul>
        <li>
          ピン（お気に入りの場所）の名称・メモ・位置・タグ、ピンをまとめる地図の名称
        </li>
        <li>
          ピンに添付する写真と、その撮影日時。撮影日時は写真の付加情報（Exif）から読み取ります（読み取れない場合、カメラで撮影した写真は撮影した時刻とします）。写真は端末で縮小・再圧縮してから送信するため、撮影位置などそのほかの付加情報は送信しません。
        </li>
      </ul>
      <p>
        写真の添付のため、カメラで撮影するときにはカメラの利用許可をお願いします。写真ライブラリからは、端末の写真選択画面で利用者が選んだ写真だけを受け取ります。
      </p>
      <p>
        ピン、写真、散歩の記録は、ご本人だけが見られ、一般には公開されません。ただし、地図の共有の機能を使った場合は、1-8
        のとおり、その地図のピンと写真が地図のメンバーに見えます。散歩の記録は共有されません。
      </p>

      <h3>1-4. ログイン状態を保つための情報</h3>
      <p>
        サインインの状態を保つための認証情報（トークン）を、端末の安全な保存領域（iOS
        のキーチェーン、Android
        のキーストア）に保存します。サーバーには、照合のための変換値（ハッシュ値）だけを保存します。
      </p>
      <p>
        Apple でサインインした場合は、これとは別に、Apple
        から受け取る認証情報（Apple
        との連携を解除するためのトークン）をサーバーに保存します。アカウントを削除するときに
        Apple へ連携の解除を依頼するために、Apple
        へそのまま送る必要があるため、変換値ではなく元の値で保存しています。サインインの際に
        Apple
        から受け取れた場合にだけ保存し、サインインし直すと新しいものに置き換え、アカウントの削除とともに削除します。
      </p>

      <h3>1-5. アクセスに伴う情報</h3>
      <p>
        本アプリや紹介サイトからサーバーへアクセスがあったとき、IP
        アドレス、アクセスの日時、リクエストの種類（URL。地図の表示範囲などを含むことがあります）と処理の結果、ブラウザやアプリの種類、アカウントの内部
        ID
        などが記録されます。散歩の軌跡やピンの名称・メモなどの入力内容は、原則としてこの記録に含めません。ただし、障害が発生した際の調査用の記録に含まれることがあります（保存期間は
        6 のとおりです）。
      </p>

      <h3 id="inquiry">1-6. お問い合わせの際に受け取る情報</h3>
      <p>
        <a href="#contact">お問い合わせ窓口</a>
        にメールをいただいた場合、送信元のメールアドレスと名前、件名、本文、添付ファイル、メールの送信の経路などの記録（ヘッダー）を受け取ります。不具合のご報告では、本文に書いていただいた端末の機種や
        OS
        のバージョンなども受け取ります。お問い合わせのメールは、本アプリのアカウントの情報とは別に、運営者の受信箱（3
        の Gmail）で保管します。保存期間は 6、削除の方法は 7 のとおりです。
      </p>

      <h3>1-7. 取得しない情報</h3>
      <ul>
        <li>
          本アプリと紹介サイトは、現在、広告、アクセス解析、クラッシュ解析のためのツールを組み込んでいません。ただし、3
          の外部サービスのうち、Google でサインインと Expo
          の部品は、サインインや更新の配信のため、利用状況やエラーの情報を各社へ直接送信することがあります（Google
          は、その情報を分析にも使うと公表しています）。紹介サイトは Cookie
          を使用していません。
        </li>
        <li>
          現在、他社のアプリやウェブサイトをまたいで利用者を追跡すること（トラッキング）は行っておらず、広告識別子も取得していません。
        </li>
        <li>連絡先、マイク、健康情報などにはアクセスしていません。</li>
      </ul>
      <p>
        これらのツールの導入など、取得する情報を変更する場合は、事前に本ポリシーを改定します。
      </p>

      <h3 id="sharing">1-8. 地図の共有（招待）で扱う情報</h3>
      <p>
        地図の持ち主は、招待のリンクを作ってほかの人に送り、その地図に招待できます。リンクを受け取った人が、アプリで招待の内容を確認して参加を選ぶと、その地図のメンバーになります。リンクを開いただけでは参加しません。
      </p>
      <ul>
        <li>
          <strong>メンバーに見える情報</strong>:
          その地図のピン（名称・メモ・位置・タグなど）と写真（撮影日時を含みます）。ほかのメンバーが追加したものも見えます。メンバーは、その地図にピン・写真・タグを追加できます。散歩の記録と、ほかの地図の情報は見えません。参加した地図には、後から持ち主が招待した人も参加することがあります。
        </li>
        <li>
          <strong>メンバーどうしに見える情報</strong>:
          地図のメンバー（持ち主を含みます）には、ほかのメンバーの表示名（1-2
          の表示名または氏名）が表示されます。メールアドレスとプロフィール画像は表示しません。
        </li>
        <li>
          <strong>招待のリンクを開いた人に見える情報</strong>:
          参加する前（サインインする前を含みます）に、地図の名称とアイコン、招待した人の表示名、リンクの有効期限が表示されます。リンクは、受け取った人であれば誰でも使えますので、送る相手と送り方にご注意ください。持ち主は、使われる前のリンクをいつでも取り消せます。
        </li>
        <li>
          <strong>保存する情報</strong>:
          招待のリンクを作ると、招待の情報（対象の地図、作った人、リンクを照合するための変換値（ハッシュ値）、有効期限、作った日時、参加した人と参加した日時、取り消した日時）を保存します。リンクそのものは保存しません。あわせて、地図のメンバーであること（役割と参加した日時）を保存します。
        </li>
      </ul>
      <p>
        地図から抜けた場合や、持ち主がメンバーから外した場合も、その人が地図に追加したピン・写真・タグは地図に残り、持ち主とほかのメンバーが引き続き見られます（削除の方法は
        7 のとおりです）。
      </p>
    </section>

    <section aria-labelledby="purpose">
      <h2 id="purpose">2. 利用目的</h2>
      <p>取得した情報は、次の目的に限って利用します。</p>
      <ul>
        <li>散歩先のスポットや、散歩のルートを提案するため</li>
        <li>散歩の軌跡・時間・距離を記録し、履歴として表示するため</li>
        <li>ピンや写真を保存し、地図に表示するため</li>
        <li>
          地図を共有したメンバーに、その地図のピンや写真と、メンバーの表示名を表示するため（1-8）
        </li>
        <li>サインインの受け付け、本人の確認、アカウントの管理のため</li>
        <li>不正な利用の防止、障害の調査と対応、セキュリティの確保のため</li>
        <li>
          本アプリの利用規約などのルールに違反する行為への対応、法令に基づく要請への対応のため
        </li>
        <li>
          本アプリに関する重要なお知らせ（仕様の変更、本ポリシーの改定、サービスの終了、セキュリティに関するお知らせなど）を連絡するため
        </li>
        <li>本アプリの改善や新しい機能の開発のため</li>
        <li>個人を識別できない形に加工した統計情報を作成するため</li>
        <li>お問い合わせや開示などのご請求に対応するため</li>
      </ul>
      <p>
        現在、位置情報を含む利用者の情報を、広告の配信や、他社が持つ情報と組み合わせた分析に利用していません。利用目的を変更する場合は、事前に本ポリシーを改定し、法令上必要な場合はあらためて同意をいただきます。
      </p>
    </section>

    <section aria-labelledby="services">
      <h2 id="services">3. 外部サービスへの送信</h2>
      <p>
        本アプリの提供のため、次の事業者のサービスを利用しています。Google Maps
        Platform、Amazon Web Services、Neon、Gmail
        は、運営者に代わって情報を処理させるか、運営者が管理する情報の保管場所として利用しています。端末から各社へ直接送信される情報（Google
        でサインイン、Apple
        でサインイン、地図の表示、Expo）は、各社のプライバシーポリシーに従って取り扱われます。
      </p>
      <div class="legal-table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">事業者・サービス</th>
              <th scope="col">用途</th>
              <th scope="col">送信される情報</th>
            </tr>
          </thead>
          <tbody>
            {externalServices.map((service) => (
              <tr>
                <td data-label="事業者・サービス">{service.provider}</td>
                <td data-label="用途">{service.purpose}</td>
                <td data-label="送信される情報">{service.data}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p>
        Google の情報の取り扱いは
        <a
          href="https://policies.google.com/privacy?hl=ja"
          rel="noopener noreferrer"
        >
          Google プライバシーポリシー
        </a>
        を、Apple の情報の取り扱いは
        <a
          href="https://www.apple.com/jp/legal/privacy/"
          rel="noopener noreferrer"
        >
          Apple のプライバシーポリシー
        </a>
        をご覧ください。
      </p>
    </section>

    <section aria-labelledby="third-party">
      <h2 id="third-party">4. 第三者への提供</h2>
      <p>
        運営者は、次の場合を除き、利用者の同意を得ずに個人情報を第三者に提供しません。個人情報を販売することもありません。
      </p>
      <ul>
        <li>法令に基づく場合</li>
        <li>
          人の生命、身体または財産の保護のために必要がある場合で、利用者の同意を得ることが困難なとき
        </li>
      </ul>
      <p>
        地図の共有（1-8）で、地図のメンバーや招待のリンクを開いた人に情報が表示されるのは、招待のリンクを作って送る、招待を受けて地図に参加するといった、利用者ご本人の操作に基づくものです。
      </p>
      <p>
        また、本アプリの運営を他の者に引き継ぐ場合は、引き継ぎ後も本ポリシーの範囲内で利用者の情報を取り扱い、事前にお知らせします。
      </p>
    </section>

    <section aria-labelledby="overseas">
      <h2 id="overseas">5. 外国でのデータの保管</h2>
      <p>
        サーバーとデータベースはシンガポールにあり、利用者の情報はシンガポールで保管されます。シンガポールには、個人情報の保護に関する法律として
        Personal Data Protection Act 2012
        があります。ただし、お問い合わせのメール（1-6）は、運営者の受信箱として利用している
        Google の Gmail に保管され、Google
        のデータセンターがある国（米国など）で保管されることがあります。また、3
        の事業者はいずれも米国の事業者で、Google の Places API・Routes
        API・Geocoding API
        への送信など、米国で処理される情報があります。米国には、連邦法として包括的な個人情報保護法はなく、分野ごとの連邦法と州法（カリフォルニア州消費者プライバシー法など）があります。各国の個人情報の保護に関する制度は、個人情報保護委員会が公表している
        <a
          href="https://www.ppc.go.jp/personalinfo/legal/kaiseihogohou/#gaikoku"
          rel="noopener noreferrer"
        >
          外国における個人情報の保護に関する制度等の調査
        </a>
        で確認できます。
      </p>
    </section>

    <section aria-labelledby="retention">
      <h2 id="retention">6. 保存期間</h2>
      <ul>
        <li>
          <strong>アカウント情報、散歩の記録、ピン、写真</strong>:
          利用者が削除するか、アカウントを削除するまで保存します（写真を削除したあとに残る管理情報、アカウントを削除したときの写真の扱い、共有した地図に追加したピンなどの扱いは
          7 のとおりです）。
        </li>
        <li>
          <strong>招待の情報（1-8）</strong>:
          参加、取り消し、有効期限の経過のいずれかから 30
          日後に削除します。地図を削除したときは、その地図の招待の情報もあわせて削除します。アカウントを削除したときは、その人が作った招待の情報と、その人が参加したことの記録を削除します。
        </li>
        <li>
          <strong>スポットやルートを探すときに送信された現在地</strong>:
          データベースには保存しません。同じ問い合わせに再利用するため、サーバーのメモリ上に短時間（数分程度）一時的に保持し、その後は利用しません（サーバーの再起動などでメモリから消えます）。
        </li>
        <li>
          <strong>散歩中に端末に一時保存する位置</strong>:
          散歩の終了時、またはアプリの次回起動時に端末から消去します。
        </li>
        <li>
          <strong>アクセスに伴う情報（1-5）</strong>:
          不正利用の防止と障害対応のために最長 400
          日保存し、期間の経過後に削除します。障害の調査用の記録も同じです。アカウントを削除した場合も、この期間は保存されます。
        </li>
        <li>
          <strong>お問い合わせのメール（1-6）</strong>:
          受信したメールの原本は、運営者の受信箱への転送に失敗した場合に備えてサーバーに
          90
          日保存し、期間の経過後に自動で削除します。運営者の受信箱では、対応の経過を確認するため、対応を終えてから最長
          3
          年保存し、期間の経過後に削除します。運営者の返信が届かなかった場合や、返信が迷惑メールとして報告された場合は、そのメールアドレスへの以後の送信を止めるため、そのメールアドレスと理由を、削除のご依頼（7）があるまでサーバーの送信停止の一覧に残し、運営者に通知します（通知は運営者の受信箱で上と同じ期間保存します）。アカウントを削除した場合も、これらは保存されます。
        </li>
      </ul>
      <p>
        削除した情報は、障害に備えたバックアップに一定期間残ることがありますが、バックアップの保存期間の経過とともに消去されます。
      </p>
      <p>
        ただし、法令に基づいて保存が必要な場合や、不正な利用の調査・防止（利用規約の禁止事項に違反して停止・削除されたアカウントの再登録の防止を含みます）のために必要な場合は、必要な範囲と期間に限り、削除の後も情報を保存することがあります。
      </p>
      <p>
        本アプリの提供を終了する場合は、相当の期間をおいて事前にお知らせし、終了後、相当の期間内に保存している情報を削除します。終了に先立って散歩の記録などを書き出す手段を用意する場合は、お知らせの際にご案内します。
      </p>
    </section>

    <section aria-labelledby="delete">
      <h2 id="delete">7. 情報の削除方法</h2>
      <ul>
        <li>
          <strong>散歩の記録</strong>:
          アプリの「アカウント」タブの「最近の散歩」（「すべて見る」から全件）で散歩を選び、「この散歩の記録を削除」から
          1 件ずつ削除できます。
        </li>
        <li>
          <strong>ピン・写真</strong>:
          ピンの詳細画面の「このピンを削除」から削除できます。写真はピンの編集画面から
          1
          枚ずつ削除できます。ほかの人の地図（1-8）に追加したピン・写真も、その地図のメンバーである間は、同じ方法で削除できます。ピンや写真を削除すると、保存している写真の画像ファイルもあわせて削除します（処理の都合上、まれに画像ファイルが保存領域に残ることがあります）。ただし、写真を管理するための情報（画像ファイルの保存場所の名前、ファイルの大きさ、写真を選んだ日時やピンに添付した日時など）は、アカウントを削除するまで残ります。写真を選んだあとにピンの登録を取りやめた場合などは、その写真の撮影日時も、アカウントを削除するまで残ります。
        </li>
        <li>
          <strong>アカウント</strong>: アプリの「アカウント」タブ
          →「設定」の「アカウントを削除」から削除できます。アカウント情報とあわせて、散歩の記録、ピンなど、アカウントに関連する情報を削除します。Apple
          でサインインしている場合は、Apple
          へ連携の解除もあわせて依頼します。Apple
          と一時的に通信できないときはアカウントを削除せずにエラーを表示しますので、時間をおいてもう一度お試しください。1-4
          の認証情報を保存していない場合や、Apple
          に依頼できなかった場合・受け付けられなかった場合は、連携を解除しないままアカウントを削除します。iPhone
          の設定に本アプリとの連携が残っている場合は、8
          の方法で解除してください。地図の共有（1-8）を使っている場合は、次のとおり扱います。
          <ul>
            <li>
              ほかの人の地図に追加した写真は削除します。ピン（名称・メモ・位置）とタグは、その地図に残り、地図の持ち主が追加したものとして扱います。残したくない場合は、アカウントを削除する前に削除してください。
            </li>
            <li>
              自分が持ち主の地図は、ほかのメンバーが追加したピン・写真を含めて削除し、メンバーからも見られなくなります。ほかのメンバーが追加した写真の画像ファイルも、あわせて削除します（処理の都合上、まれに画像ファイルが保存領域に残ることがあります）。
            </li>
          </ul>
        </li>
        <li>
          <strong>地図の共有</strong>:
          地図のメンバーは、その地図のメンバーの画面から、地図から抜けられます。抜けても、自分が追加したピン・写真・タグは地図に残ります。残したくない場合は、抜ける前に削除してください（抜けた後は、その地図を見ることも、追加したものを削除することもできなくなります）。地図の持ち主は、メンバーを外すことや、地図を削除することができます。
        </li>
        <li>
          <strong>お問い合わせのメール</strong>:
          アカウントを削除しても削除されません。削除をご希望の場合は、お問い合わせに使ったメールアドレスから
          <a href="#contact">お問い合わせ窓口</a>
          までご連絡ください。ご本人の確認のため、運営者から、そのメールアドレス宛てに確認のメールを新しくお送りします（いただいたメールへの返信ではお送りしません）。確認できたら、運営者の受信箱と送信停止の一覧から削除します（サーバーに保存した原本は、6
          のとおり 90 日で自動で削除されます）。
        </li>
      </ul>
      <p>
        アカウントを削除すると、写真を表示するための情報はすぐに削除され、アプリから写真を見ることはできなくなります。ピンに添付した写真の画像ファイルは、障害や誤操作への対応に備えて削除から
        30 日間保存したのち、保存領域から削除します（削除の処理は 1 日 1
        回まとめて行うため、30
        日を過ぎてから数日かかることがあります）。自分が持ち主の地図に、ほかのメンバーが追加した写真の画像ファイルは、30
        日を待たずに削除します。
      </p>
      <p>
        アプリから削除できない場合（アプリを削除済みの場合など）は、10 の方法で
        <a href="#contact">お問い合わせ窓口</a>からご依頼いただけます。
      </p>
    </section>

    <section aria-labelledby="withdraw">
      <h2 id="withdraw">8. 位置情報などの利用の停止（同意の撤回）</h2>
      <p>
        位置情報やカメラの利用許可は、端末の設定からいつでも取り消せます。取り消した場合、スポットを探す機能や散歩を記録する機能など、位置情報を使う機能は利用できなくなります。
      </p>
      <ul>
        <li>
          <strong>iPhone</strong>:
          「設定」→「プライバシーとセキュリティ」→「位置情報サービス」→「sanposcape」で「なし」を選びます（iOS
          のバージョンによって名称が異なる場合があります）。
        </li>
        <li>
          <strong>Android</strong>:
          「設定」→「アプリ」→「sanposcape」→「権限」→「位置情報」で「許可しない」を選びます（機種や
          Android のバージョンによって名称が異なる場合があります）。
        </li>
      </ul>
      <p>
        散歩中の位置の記録は、アプリで散歩を終了するといつでも止められます。Google
        アカウントとの連携は、Google アカウントの設定画面から、Apple
        アカウントとの連携は、iPhone の「設定」→ ご自身の名前
        →「サインインとセキュリティ」→「Apple
        でサインイン」から解除できます（iOS
        のバージョンによって名称が異なる場合があります）。連携を解除しても、運営者が保存している情報は削除されません。削除は
        7 の方法で行ってください。
      </p>
    </section>

    <section aria-labelledby="security">
      <h2 id="security">9. 安全管理のための措置</h2>
      <p>
        運営者は、取得した情報の漏えいや紛失を防ぐため、次の措置を講じています。
      </p>
      <ul>
        <li>
          <strong>基本方針・取扱いのルール</strong>:
          本ポリシーを基本方針とし、取得・利用・保存・削除の各段階での取り扱い方法を定めています。
        </li>
        <li>
          <strong>組織的・人的な措置</strong>:
          個人情報を取り扱うのは運営者に限っています。本アプリの開発・運用にあたって、利用者の個人情報を生成
          AI のサービスに入力しません。
        </li>
        <li>
          <strong>物理的な措置</strong>:
          作業に使う端末には画面ロックを設定し、紛失・盗難に備えています。
        </li>
        <li>
          本アプリ・紹介サイトとサーバーとの通信を暗号化（HTTPS）し、保存する写真やデータを暗号化しています。
        </li>
        <li>
          サーバーやデータベースへのアクセスを、必要な権限に限っています。
        </li>
        <li>
          ログイン状態を保つための認証情報は、サーバーには照合のための変換値（ハッシュ値）だけを保存しています（Apple
          との連携を解除するためのトークンは、1-4
          のとおり元の値で保存しています）。
        </li>
        <li>
          外国（5
          のとおり）で情報を保管するにあたり、その国の個人情報の保護に関する制度を把握したうえで措置を講じています。
        </li>
      </ul>
    </section>

    <section aria-labelledby="requests">
      <h2 id="requests">10. 開示などのご請求</h2>
      <p>
        利用者は、運営者が保有するご自身の個人情報について、利用目的の通知、開示、訂正・追加・削除、利用の停止・消去、第三者への提供の停止、第三者提供の記録の開示を請求できます。
        <a href="#contact">お問い合わせ窓口</a>
        までメールでご連絡ください。ご本人であることを確認したうえで、法令に従って遅滞なく対応します。手数料はいただきません。
      </p>
      <ul>
        <li>
          ご請求の際は、本アプリへのサインインに使っているアカウントの種類（Google
          または Apple）と、そのメールアドレスをお知らせください。Apple
          でサインインする際に「メールを非公開」を選んだ場合は、Apple
          の転送用のアドレスをお知らせください（iPhone の「設定」→ ご自身の名前
          →「サインインとセキュリティ」→「Apple
          でサインイン」で本アプリを選ぶと確認できます。iOS
          のバージョンによって名称が異なる場合があります）。
        </li>
        <li>
          ご本人の確認のため、運営者から、そのアカウントのメールアドレス宛てに、ご請求の内容と確認用のコードを記載したメールをお送りします。確認用のコードを添えて、そのメールに返信してください。「メールを非公開」を選んだ場合は、Apple
          の転送用のアドレス経由で届きます。必要に応じて、追加の確認をお願いすることがあります。
        </li>
        <li>
          開示の結果などのご回答は、確認したアカウントのメールアドレス宛てにお送りします。
        </li>
        <li>
          ご本人であることを確認できない場合は、ご請求に応じられないことがあります。
        </li>
        <li>開示は、原則として電子データでお送りします。</li>
      </ul>
    </section>

    <section aria-labelledby="minors">
      <h2 id="minors">11. 未成年の方の利用</h2>
      <p>
        13 歳未満の方は、本アプリを利用できません。13
        歳以上の未成年の方は、保護者の方の同意を得たうえで本アプリを利用してください。
      </p>
    </section>

    <section aria-labelledby="changes">
      <h2 id="changes">12. 本ポリシーの変更</h2>
      <p>
        運営者は、法令の変更や本アプリの機能の変更にあわせて、本ポリシーを変更することがあります。変更した場合はこのページで告知し、変更後の本ポリシーは、このページに掲載した時点（施行日を定めた場合は施行日）から効力を生じます。利用者に不利益となる変更は、施行日を定めて事前にこのページで告知し、変更前の本ポリシーもこのページから確認できるようにします。利用者の情報の取り扱いが大きく変わる場合は、本アプリでの表示や登録されたメールアドレスへの連絡など、適切な方法でもお知らせします。法令上必要な場合は、あらためて同意をいただきます。
      </p>
    </section>

    <section aria-labelledby="contact">
      <h2 id="contact">13. 運営者・お問い合わせ窓口</h2>
      <p>
        本ポリシーや個人情報の取り扱いに関するお問い合わせ・苦情は、次の窓口で受け付けます。
      </p>
      <dl class="legal-contact">
        <dt>運営者</dt>
        <dd>Sanposcape 運営者</dd>
        <dt>お問い合わせ</dt>
        <dd>
          <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
        </dd>
      </dl>
      <p>
        運営者の氏名と住所は、本アプリの利用者ご本人から、個人情報の取り扱いに関するご請求があった場合に、遅滞なくお知らせします。
      </p>
    </section>

    <section aria-labelledby="history">
      <h2 id="history">改定履歴</h2>
      <ul>
        {revisionHistory.map((revision) => (
          <li>
            {revision.revisedOn} 改定（{revision.effectiveOn} 施行）:{" "}
            {revision.summary}
            <a href={revision.previousHref}>{revision.previousLabel}</a>
          </li>
        ))}
      </ul>
    </section>
