---
import Download from "../components/Download.astro";
import Hero from "../components/Hero.astro";
import Pins from "../components/Pins.astro";
import Steps from "../components/Steps.astro";
import StoreDialog from "../components/StoreDialog.astro";
import Together from "../components/Together.astro";
import Walks from "../components/Walks.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Sanposcape — 散歩の発見を、自分たちの地図に。"
  description="休日の散歩で見つけた場所を、写真とタグ付きのピンで自分たちだけの地図に。家族や友人を招待して一緒に育てられます。平日は、すきま時間で歩ける散歩コースを提案。Sanposcapeは、休日も平日も散歩を楽しくするアプリです。"
  isHome
>
  <Hero />
  <Pins />
  <Together />
  <Walks />
  <Steps />
  <Download />
  <StoreDialog slot="after-footer" />
</BaseLayout>
