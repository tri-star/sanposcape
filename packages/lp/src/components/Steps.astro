---
import { Image } from "astro:assets";
import pinNew from "../assets/images/screens/pin-new.png";
import pinDetailShowa from "../assets/images/screens/pin-detail-showa.png";
import mapMembers from "../assets/images/screens/map-members.png";
---

<section class="how-section container" aria-labelledby="how-title">
  <div class="section-heading">
    <p class="eyebrow">MAKE IT YOUR MAP</p>
    <h2 id="how-title">
      地図のはじめかたは、
      <br class="mobile-break" />
      かんたん。
    </h2>
    <p>ピンを立てて、写真とタグを添えて、招待するだけ。</p>
  </div>
  <div class="steps">
    <article class="step">
      <span class="step-index">STEP 01</span>
      <div class="step-art screen-art" aria-hidden="true">
        <figure class="phone step-phone">
          <Image
            src={pinNew}
            alt=""
            width={720}
            height={740}
            widths={[200, 400]}
            sizes="200px"
          />
        </figure>
        <span class="art-label">ここ、また来たいかも。</span>
      </div>
      <h3>見つけて、ピン。</h3>
      <p>
        散歩中に見つけた場所を、
        <br />
        地図にピンで登録。
      </p>
    </article>
    <article class="step">
      <span class="step-index">STEP 02</span>
      <div class="step-art screen-art" aria-hidden="true">
        <figure class="phone step-phone">
          <Image
            src={pinDetailShowa}
            alt=""
            width={720}
            height={740}
            widths={[200, 400]}
            sizes="200px"
          />
        </figure>
        <span class="art-label">夕方の景色も、ひとことも。</span>
      </div>
      <h3>写真とタグを、添えて。</h3>
      <p>
        見つけた風景や感じたことを、
        <br />
        写真・タグ・メモで残す。
      </p>
    </article>
    <article class="step">
      <span class="step-index">STEP 03</span>
      <div class="step-art screen-art" aria-hidden="true">
        <figure class="phone step-phone">
          <Image
            src={mapMembers}
            alt=""
            width={720}
            height={740}
            widths={[200, 400]}
            sizes="200px"
          />
        </figure>
        <span class="art-label">みんなの地図に。</span>
      </div>
      <h3>招待して、一緒に。</h3>
      <p>
        家族や友人を地図に招待して、
        <br />
        お気に入りを一緒に集める。
      </p>
    </article>
  </div>
</section>
