---
import { Image } from "astro:assets";
import pinDetail from "../assets/images/screens/pin-detail.png";
---

<section
  class="pin-section section-wrap"
  id="pins"
  aria-labelledby="pins-title"
>
  <div class="container pin-layout">
    <div class="feature-copy">
      <p class="eyebrow light">
        <span class="section-number">01</span> FOR HOLIDAY WALKS
      </p>
      <h2 id="pins-title">
        写真とタグで残す、
        <br />
        自分たちだけの地図。
      </h2>
      <p class="section-description">
        休日の散歩で見つけた、昔ながらの町中華や気になるお店のメニュー。
        <br />
        地図アプリの「保存」だけでは残せない写真とタグを添えて、
        <br />
        一般には公開されない、自分たちだけの地図に集めていきます。
      </p>
      <div class="pin-features">
        <div>
          <span class="feature-icon">
            <svg class="icon">
              <use href="#i-pin"></use>
            </svg>
          </span>
          <div>
            <h3>見つけたら、その場でピン。</h3>
            <p>散歩中のボタンでも、地図の長押しでも、その場所を記録。</p>
          </div>
        </div>
        <div>
          <span class="feature-icon">
            <svg class="icon">
              <use href="#i-camera"></use>
            </svg>
          </span>
          <div>
            <h3>写真とタグで、思い出ごと残す。</h3>
            <p>
              写真・タグ・メモ付きのピンは、地図のメンバーだけが見られます。
            </p>
          </div>
        </div>
        <div>
          <span class="feature-icon">
            <svg class="icon">
              <use href="#i-note"></use>
            </svg>
          </span>
          <div>
            <h3>「あの場所」に、すぐ戻れる。</h3>
            <p>ピンを名前で検索して、地図上のその場所へ移動。</p>
          </div>
        </div>
      </div>
      <span class="handwritten">小さな発見が、自分たちの地図になる。</span>
    </div>
    <div class="pin-visual">
      <div class="pin-orbit" aria-hidden="true"></div>
      <figure class="phone detail-phone">
        <Image
          src={pinDetail}
          alt="ピンの詳細画面。昔ながらの町中華に、お店と料理の写真・タグ・メモが保存されています。"
          width={720}
          height={1560}
          widths={[240, 480, 720]}
          sizes="240px"
        />
      </figure>
      <div class="mini-note">
        <span class="tiny-label">MY FAVORITE SPOT</span>
        <svg class="icon">
          <use href="#i-pin"></use>
        </svg>
        <strong>気になる町中華</strong>
        <p>
          昭和の初めから続くお店。
          <br />
          次は餃子と半チャーハンを。
        </p>
        <div class="note-tags">
          <span># 町中華</span>
          <span># 老舗</span>
        </div>
      </div>
      <span class="visual-label">写真とメモで、思い出までピンに。</span>
    </div>
  </div>
</section>
