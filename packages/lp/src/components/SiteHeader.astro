---
import { Image } from "astro:assets";
import appIcon from "../assets/images/app-icon.png";

interface Props {
  /** トップページ以外では、ページ内リンクの前にトップページのパスを付ける */
  isHome: boolean;
}

const { isHome } = Astro.props;
const top = isHome ? "" : "/";
---

<header class="site-header">
  <div class="container">
    <a class="brand" href={isHome ? "#" : "/"} aria-label="Sanposcape ホーム">
      <Image
        src={appIcon}
        alt=""
        width={36}
        height={36}
        densities={[1, 2, 3]}
        loading="eager"
      />
      <span>sanposcape</span>
    </a>
    <nav aria-label="メインナビゲーション">
      <a href={`${top}#pins`}>写真とタグの地図</a>
      <a href={`${top}#together`}>地図の共有</a>
      <a href={`${top}#walks`}>散歩コース</a>
      <a class="nav-download" href={`${top}#download`}>
        ダウンロード
      </a>
    </nav>
  </div>
</header>
